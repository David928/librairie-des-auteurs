NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clé service_role : toutes les modifications (fiches, livres, dédicaces,
# annonces, envoi de photos) passent par le serveur avec cette clé, après
# vérification des droits. Ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email du compte libraire (superadmin) : gère tous les auteurs, livres,
# dédicaces et annonces de la librairie.
SUPERADMIN_EMAIL=your-admin-login-email

# Envoi des identifiants aux auteurs (Brevo > SMTP & API > API Keys).
# Sans elle, tout fonctionne : les identifiants sont juste affichés à l'écran.
BREVO_API_KEY=your-brevo-api-key

# Notifications push. Générer une paire avec : npx web-push generate-vapid-keys
# Sans elles, l'app fonctionne mais aucune notification n'est envoyée.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
